# ---- Left behind by switching branches --------------------------------
# Untracked files survive a checkout, so running `npm install` on main and
# then checking out this branch leaves node_modules/ sitting here, where a
# careless `git add -A` would commit all 2,866 files of it.
node_modules/
package-lock.json
.screenshots/

