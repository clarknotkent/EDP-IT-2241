# Milestone 1 was authored on macOS (LF) and Milestones 2 and 3 on Windows
# (CRLF). This pins everything to LF so future diffs show real changes only.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,js,css,html}]
indent_size = 2
