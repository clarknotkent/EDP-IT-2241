{
  "name": "mini-addu-sis",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind build for the Django templates. The Python app does not need Node to run.",
  "scripts": {
    "build:css": "NODE_ENV=production postcss static/src/app.css -o static/css/app.css --no-map",
    "watch:css": "postcss static/src/app.css -o static/css/app.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "10.4.18",
    "postcss": "8.4.37",
    "postcss-cli": "10.1.0",
    "tailwindcss": "3.4.3"
  }
}
