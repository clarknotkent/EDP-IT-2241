# GitHub's language bar is computed by Linguist from bytes on the default
# branch. Without these overrides it reports this Django project as mostly CSS
# and HTML, because one generated stylesheet outweighs every hand-written
# Python file.

# Generated by `npm run build:css` from static/src/app.css. Not authored here.
static/css/app.css   linguist-generated=true

# Django templates are HTML, but they are markup this project renders rather
# than a front end anyone would call a language contribution.
templates/**/*.html  linguist-detectable=false

# Keep line endings sane across the macOS/Windows split this project came from.
*        text=auto eol=lf
*.png    binary
*.svg    text eol=lf
